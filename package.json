{
  "name": "alcohol-label-verification-fed",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --env-file-if-exists=.env src/server.ts\" \"vite\"",
    "start": "tsx --env-file-if-exists=.env src/server.ts",
    "start:prod": "node --env-file-if-exists=.env dist/server/server.js",
    "build": "npm run typecheck && npm run build:server && vite build",
    "build:server": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:generate": "tsx scripts/generate-fixtures.ts",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.0.0",
    "@scalar/express-api-reference": "^0.10.6",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "multer": "^2.0.2",
    "openai": "^6.0.0",
    "sharp": "^0.35.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.0.0",
    "@types/supertest": "^6.0.0",
    "axe-core": "^4.10.0",
    "concurrently": "^9.2.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
